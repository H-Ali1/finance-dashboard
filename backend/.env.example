# Copy to backend/.env and fill in whichever providers you want.
# This file stays on your machine — .env is gitignored.

# --- Starling ---------------------------------------------------------------
# developer.starlingbank.com -> Personal Access -> create token with the
# account:read, balance:read, transaction:read, savings-goal:read scopes.
STARLING_ACCESS_TOKEN=

# --- Trading 212 ------------------------------------------------------------
# App -> Settings -> API (Beta) -> generate key (read scopes only).
TRADING212_API_KEY=
# Use https://demo.trading212.com/api/v0 to test against a practice account.
TRADING212_BASE_URL=https://live.trading212.com/api/v0

# --- app --------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
# Hours between automatic syncs; 0 turns the schedule off.
SYNC_INTERVAL_HOURS=6
# Daily database copies kept in backups/ next to the database.
BACKUP_KEEP_DAYS=7
# Comma-separated client IPs allowed to connect. Empty allows everyone.
ALLOWED_CLIENT_IPS=
ESSENTIAL_CATEGORIES=Groceries,Bills & Utilities,Rent & Mortgage,Insurance,Transport,Fuel,Health & Fitness
